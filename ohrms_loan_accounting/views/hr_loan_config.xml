<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_config_inherit" model="ir.ui.view">
        <field name="name">Accounting  settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Loan Approval" name="loan_approval_setting_container">
                    <setting help="Loan Approval from account manager">
                        <field name="loan_approve"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
